{
  "name": "metraly",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "ui:build-dep": "npm --prefix ../../brandbook/packages/ui install && npm --prefix ../../brandbook/packages/ui run build",
    "predev": "npm run ui:build-dep",
    "dev": "vite",
    "prebuild": "npm run ui:build-dep",
    "build": "vite build",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "quality": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@metraly/ui": "file:../../brandbook/packages/ui",
    "@tanstack/react-query": "^5.100.14",
    "axios": "^1.15.2",
    "nanoid": "^5.1.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-grid-layout": "^2.2.3",
    "recharts": "^3.8.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "knip": "^6.15.0",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
